# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MySQL Database ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mockiq_db

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# ─── Bcrypt ───────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=10

# ─── CORS ─────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Ollama (AI) ──────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
